{% comment %}
  Shared body for /publications.json and /api/publications.json.
  Derived entirely from _publications front matter via _includes/pub-meta.html.
{% endcomment %}
{
  "generated": {{ site.time | date: '%Y-%m-%dT%H:%M:%S%z' | jsonify }},
  "count": {{ site.publications | size }},
  "publications": [
{%- for doc in site.publications reversed %}
{%- include pub-meta.html doc=doc -%}
{%- capture bibtex -%}{%- include bibtex-entry.html doc=doc -%}{%- endcapture %}
    {
      "id": {{ pub_key | jsonify }},
      "type": {{ pub_entry_type | jsonify }},
      "title": {{ doc.title | jsonify }},
      "authors": [
        {%- for pub_author in pub_authors -%}
          {{ pub_author | strip | jsonify }}{% unless forloop.last %}, {% endunless %}
        {%- endfor -%}
      ],
      "category": {{ doc.category | jsonify }},
      "venue": {{ doc.venue | jsonify }},
      "venue_short": {{ doc.venue_short | jsonify }},
      "venue_url": {{ doc.venue_url | jsonify }},
      "date": {{ doc.date | date: '%Y-%m-%d' | jsonify }},
      "year": {{ pub_year | jsonify }},
      "url": {{ pub_abs_url | jsonify }},
      "pdf": {{ pub_pdf_url | jsonify }},
      "doi": {{ doc.doi | jsonify }},
      "arxiv": {{ doc.arxiv | jsonify }},
      "abstract": {{ doc.content | markdownify | strip_html | strip_newlines | jsonify }},
      "bibtex": {{ bibtex | strip | jsonify }}
    }{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ]
}
